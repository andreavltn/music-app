<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="collection.view.TrackFormController"
      stylesheets="@style.css"
      spacing="10"
      styleClass="root"
      style="-fx-padding: 20;"
      prefWidth="360">

    <!-- Champs de saisie -->
    <Label text="Artiste" styleClass="text-muted"/>
    <ComboBox fx:id="artistComboBox" styleClass="input-field" editable="true" maxWidth="Infinity"/>
    <Label text="Album" styleClass="text-muted"/>
    <ComboBox fx:id="albumComboBox" styleClass="input-field" editable="true" maxWidth="Infinity"/>
    <Label text="Titre"            styleClass="text-muted"/>
    <TextField fx:id="titleField"    styleClass="input-field"/>
    <Label text="Genre"            styleClass="text-muted"/>
    <TextField fx:id="genreField"    styleClass="input-field"/>
    <Label text="Année"            styleClass="text-muted"/>
    <TextField fx:id="yearField"     styleClass="input-field"/>
    <Label text="Durée (secondes)" styleClass="text-muted"/>
    <TextField fx:id="durationField" styleClass="input-field"/>

    <!-- Fichier mp3 -->
    <Label text="Fichier MP3" styleClass="text-muted"/>
    <HBox spacing="8">
        <TextField fx:id="filePathField" styleClass="input-field" editable="false" HBox.hgrow="ALWAYS"/>
        <Button onAction="#onChooseFile" text="Parcourir" styleClass="btn-dark"/>
        <Button onAction="#onClearFile" text="✕" styleClass="btn-red" prefWidth="30"/>
    </HBox>

    <!-- Image -->
    <Label text="Image" styleClass="text-muted"/>
    <HBox spacing="8">
        <TextField fx:id="imagePathField" styleClass="input-field" editable="false" HBox.hgrow="ALWAYS"/>
        <Button onAction="#onChooseImage" text="Parcourir" styleClass="btn-dark"/>
        <Button onAction="#onClearImage" text="✕" styleClass="btn-red" prefWidth="30"/>
    </HBox>

    <!-- Message d'erreur (vide par défaut) -->
    <Label fx:id="errorLabel" styleClass="error-label"/>

    <!-- Boutons de validation -->
    <HBox spacing="10">
        <Button onAction="#onSave"   text="Enregistrer" styleClass="btn-green"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button onAction="#onCancel" text="Annuler"     styleClass="btn-dark"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

</VBox>