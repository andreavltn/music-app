<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ProgressBar?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="collection.view.MainController">

   <!-- MENU EN HAUT (recherche et filtre) -->
   <top>
      <HBox styleClass="menu-bar">

         <!-- Champ de recherche à gauche -->
         <TextField fx:id="searchField" prefHeight="26.0" prefWidth="227.0"
                    promptText="Recherche..." styleClass="input-field"/>

         <!-- Region qui pousse tout ce qui suit vers la droite -->
         <Region HBox.hgrow="ALWAYS"/>

         <!-- Composants de tri à droite -->
         <Label styleClass="text-white" text="Trier par :"/>
         <ComboBox fx:id="sortComboBox" prefHeight="26.0" prefWidth="102.0" styleClass="input-field"/>
         <Button fx:id="sortOrderBtn" onAction="#onToggleSortOrder"
                 prefHeight="26.0" prefWidth="30.0"
                 styleClass="btn-dark" text="↑"/>
      </HBox>
   </top>

   <!-- CENTRE (liste des titres + détails du titre) -->
   <center>
      <HBox prefWidth="Infinity">

         <!-- Liste des titres -->
         <ListView fx:id="trackListView" styleClass="track-list" prefWidth="250"
                   minWidth="250"  HBox.hgrow="NEVER"/>

         <!-- Panneau des détails -->
         <VBox prefWidth="250" minWidth="250" styleClass="detail-panel" HBox.hgrow="NEVER">
            <Label text="Détails" styleClass="text-muted"/>
            <Label fx:id="detailTitle" styleClass="text-white"
                   style="-fx-font-weight: bold; -fx-font-size: 14; -fx-wrap-text: true;"/>
            <Label fx:id="detailArtist" styleClass="text-secondary" style="-fx-wrap-text: true;"/>
            <Label fx:id="detailAlbum" styleClass="text-secondary" style="-fx-wrap-text: true;"/>
            <Label fx:id="detailGenre" styleClass="text-muted"/>
            <Label fx:id="detailYear" styleClass="text-muted"/>
            <Label fx:id="detailDuration" styleClass="text-muted"/>

            <!-- Région qui pousse tout ce qui suit vers le bas -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Boutons Modifier et Supprimer -->
            <Button onAction="#onEdit" text="Modifier" styleClass="btn-blue" maxWidth="Infinity"/>
            <Button onAction="#onDelete" text="Supprimer" styleClass="btn-red" maxWidth="Infinity"/>
         </VBox>

         <!-- Panneau lecteur MP3 -->
         <VBox styleClass="detail-panel" maxWidth="Infinity" prefWidth="9999" HBox.hgrow="ALWAYS" spacing="16">
            <Label text="Lecteur" styleClass="text-muted"/>
            <Label fx:id="playerTitle" styleClass="text-white"
                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-wrap-text: true;"/>
            <Label fx:id="playerArtist" styleClass="text-secondary"/>

            <!-- Région qui pousse tout ce qui suit vers le bas -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Image de couverture -->
            <ImageView fx:id="playerImage" fitWidth="150" fitHeight="150" preserveRatio="true"/>

            <!-- Barre de progression -->
            <ProgressBar fx:id="progressBar" prefWidth="Infinity" maxWidth="Infinity" progress="0"/>
            <Label fx:id="timeLabel" styleClass="text-muted" text="0:00 / 0:00"/>

            <!-- Boutons play et stop -->
            <HBox alignment="CENTER" spacing="10">
               <Button fx:id="playBtn" onAction="#onPlayOrPause" text="▶" styleClass="btn-dark" prefWidth="40"/>
               <Button fx:id="stopBtn" onAction="#onStop" text="■" styleClass="btn-dark" prefWidth="40"/>
            </HBox>
         </VBox>
      </HBox>
   </center>

   <!-- MENU EN BAS (boutons) -->
   <bottom>
      <HBox styleClass="menu-bar" spacing="10">

         <!-- Boutons -->
         <Button onAction="#onAdd"   styleClass="btn-green" text="Ajouter un titre"/>
         <Button onAction="#onImport" styleClass="btn-emerald" text="Importer"/>
         <Button onAction="#onExport" styleClass="btn-cyan" text="Exporter"/>

         <!-- Nombre de titres -->
         <Label fx:id="countLabel"  styleClass="text-muted"/>
      </HBox>
   </bottom>

</BorderPane>